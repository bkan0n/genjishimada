# Local Development Environment Configuration
# Copy this to .env.local and customize as needed

# Application
APP_ENVIRONMENT=local

# PostgreSQL (points to Docker Compose local service)
POSTGRES_HOST=localhost
POSTGRES_USER=genji
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=genjishimada

# Queue worker (provision with just queue-credentials-local after migrations)
# The provisioner writes the generated queue-only URL here. Never reuse the API owner login.
# Without the URL override, use POSTGRES_HOST/POSTGRES_DB with the queue-only role and password.
QUEUE_DATABASE_URL=
QUEUE_DATABASE_PASSWORD=
QUEUE_OPERATOR_IDS=141372217677053952

# MinIO (S3-compatible local storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=genji-parkour-images
S3_PUBLIC_URL=http://localhost:9000/genji-parkour-images
AWS_ACCESS_KEY_ID=genji
AWS_SECRET_ACCESS_KEY=local_dev_password

# Discord (use a test bot or dev bot token)
DISCORD_TOKEN=your_dev_bot_token_here
DISCORD_GUILD_ID=your_test_guild_id_here

# API Key (for bot to call API)
API_KEY=local_dev_api_key

# Email (optional for local dev)
RESEND_API_KEY=re_test_key

# Sentry (optional for local dev, leave empty to disable)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_FEEDBACK_URL=
SENTRY_RELEASE=local-dev
